{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "lib": [
            "ES2020"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "strict": false,
        "noUnusedParameters": false
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "test"
    ]
}
